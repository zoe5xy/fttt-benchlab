    "local_changes": [
      "Package initializers expose only the extracted subset.",
      "DIP/INR/DPS add optional loss, observation and work-control hooks.",
      "VPSchedule fixes the final clean step and rejects duplicate inference timesteps."
    ]
  },
  "adaptations": [
    "First-arrival-only case schema and optional pick confidence.",
    "DIP, INR and DPS share the included Eikonal forward model and adjoint.",
    "Configurations and example weights resolve inside this source directory."
